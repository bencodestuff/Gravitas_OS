# Auto-generated by configure.py

rule cxx
  command = clang++ -target x86_64-unknown-none-elf -ffreestanding -fno-stack-protector -fno-rtti -fno-exceptions -mno-red-zone -mno-mmx -mno-sse -mno-sse2 -Wall -Wextra -Isrc -Isrc/kernel -std=c++20 -g -c $in -o $out
  description = CXX $in

rule asm
  command = clang++ -target x86_64-unknown-none-elf -ffreestanding -fno-stack-protector -fno-rtti -fno-exceptions -mno-red-zone -mno-mmx -mno-sse -mno-sse2 -Wall -Wextra -Isrc -Isrc/kernel -std=c++20 -g -c $in -o $out
  description = ASM $in

rule link
  command = ld.lld -nostdlib -static -z max-page-size=0x1000 -T src/arch/x86_64/linker.ld $in -o $out
  description = LINK $out

rule iso
  command = ./build_iso.sh
  description = ISO gravitas.iso

rule run
  command = qemu-system-x86_64 -cdrom gravitas.iso -m 512M -serial stdio
  description = RUN gravitas.iso

rule clean
  command = rm -rf bin obj iso_root gravitas.iso
  description = CLEAN

build obj/src_kernel_main.cpp.o: cxx src/kernel/main.cpp

build bin/gravitas.elf: link obj/src_kernel_main.cpp.o
build iso: iso bin/gravitas.elf
build run: run iso
build clean: clean

default bin/gravitas.elf
